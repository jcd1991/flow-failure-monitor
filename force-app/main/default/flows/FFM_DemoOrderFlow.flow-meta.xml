<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Portfolio demo: intentionally fails an Apex action and captures the fault through a real Flow fault connector.</description>
    <interviewLabel>FFM Demo Order Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FFM Demo Order Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector><targetReference>TriggerFailure</targetReference></connector>
    </start>
    <actionCalls>
        <name>TriggerFailure</name>
        <label>Trigger controlled demo failure</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <actionName>FFM_DemoFailureAction</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <faultConnector><targetReference>CaptureFault</targetReference></faultConnector>
    </actionCalls>
    <actionCalls>
        <name>CaptureFault</name>
        <label>Capture fault in Flow Failure Monitor</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <actionName>FFM_DemoFaultLogger</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>messages</name>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </inputParameters>
    </actionCalls>
    <status>Active</status>
</Flow>
