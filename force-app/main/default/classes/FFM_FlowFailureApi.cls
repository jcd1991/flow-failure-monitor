@RestResource(urlMapping='/ffm/v1/*')
global with sharing class FFM_FlowFailureApi {
    @HttpGet global static void get() {
        RestResponse response = RestContext.response;
        response.addHeader('Cache-Control','no-store');
        response.addHeader('Content-Type','application/json');
        try {
            if (!FeatureManagement.checkPermission('FFM_API_Access')) { write(response,403,error('FORBIDDEN','API access is not enabled')); return; }
            String path=RestContext.request.requestURI; Integer marker=path.indexOf('/ffm/v1/'); String route=marker>=0?path.substring(marker+8):''; if(route.endsWith('/'))route=route.substring(0,route.length()-1);
            if(route=='capabilities'){write(response,200,new Map<String,Object>{'apiVersion'=>'v1','modules'=>new List<String>{'read','grouping','history'}});return;}
            if(route=='summary'){summary(response);return;} if(route=='groups'){groups(response);return;}
            if(route.startsWith('groups/')&&route.endsWith('/history')){history(response,route.substring(7,route.length()-8));return;}
            if(route.startsWith('groups/')&&route.endsWith('/samples')){samples(response,route.substring(7,route.length()-8));return;}
            if(route.startsWith('groups/')){group(response,route.substring(7));return;} if(route.startsWith('samples/')){sample(response,route.substring(8));return;}
            if(route=='trends'){trends(response);return;} if(route=='stats'){stats(response);return;} if(route=='search'){search(response);return;}
            write(response,404,error('NOT_FOUND','Unknown Flow Failure Monitor route'));
        } catch(Exception ex){write(response,500,error('INTERNAL_ERROR','The request could not be completed'));}
    }
    private static void summary(RestResponse r){Map<String,Integer> c=new Map<String,Integer>();for(AggregateResult a:[SELECT Status__c status,COUNT(Id) total FROM Failure_Group__c WITH USER_MODE GROUP BY Status__c])c.put(String.valueOf(a.get('status')),Integer.valueOf(String.valueOf(a.get('total'))));write(r,200,new Map<String,Object>{'data'=>c,'windowDays'=>30});}
    private static void groups(RestResponse r){Integer n=limitValue();List<Failure_Group__c> rows=[SELECT Id,Fingerprint__c,Flow_Name__c,Element_Name__c,Error_Type__c,Occurrence_Count__c,First_Seen__c,Last_Seen__c,Status__c,Representative_Message__c FROM Failure_Group__c WITH USER_MODE ORDER BY Last_Seen__c DESC,Id DESC LIMIT :n];write(r,200,new Map<String,Object>{'data'=>rows,'page'=>new Map<String,Object>{'hasMore'=>rows.size()==n,'limit'=>n}});}
    private static void group(RestResponse r,String id){if(!isId(id)){write(r,400,error('INVALID_ID','Group id is invalid'));return;}write(r,200,new Map<String,Object>{'data'=>[SELECT Id,Fingerprint__c,Flow_Name__c,Element_Name__c,Error_Type__c,Occurrence_Count__c,First_Seen__c,Last_Seen__c,Status__c,Representative_Message__c FROM Failure_Group__c WHERE Id=:id WITH USER_MODE LIMIT 1]});}
    private static void samples(RestResponse r,String id){if(!isId(id)){write(r,400,error('INVALID_ID','Group id is invalid'));return;}Integer n=limitValue();List<Flow_Error__c> rows=[SELECT Id,Name,Flow_Name__c,Element_Name__c,Fault_Message__c,Object_Type__c,Status__c,Occurred_At__c,Correlation_Id__c,Source__c,Redaction_Applied__c FROM Flow_Error__c WHERE Failure_Group__c=:id WITH USER_MODE ORDER BY Occurred_At__c DESC,Id DESC LIMIT :n];write(r,200,new Map<String,Object>{'data'=>rows,'page'=>new Map<String,Object>{'hasMore'=>rows.size()==n,'limit'=>n}});}
    private static void sample(RestResponse r,String id){if(!isId(id)){write(r,400,error('INVALID_ID','Sample id is invalid'));return;}write(r,200,new Map<String,Object>{'data'=>[SELECT Id,Name,Flow_Name__c,Element_Name__c,Fault_Message__c,Object_Type__c,Status__c,Occurred_At__c,Correlation_Id__c,Source__c,Context_Json__c,Redaction_Applied__c FROM Flow_Error__c WHERE Id=:id WITH USER_MODE LIMIT 1]});}
    private static void trends(RestResponse r){DateTime since=System.now().addDays(-30);List<Map<String,Object>> d=new List<Map<String,Object>>();for(AggregateResult a:[SELECT DAY_ONLY(Occurred_At__c) day,COUNT(Id) total FROM Flow_Error__c WHERE Occurred_At__c>=:since WITH USER_MODE GROUP BY DAY_ONLY(Occurred_At__c) ORDER BY DAY_ONLY(Occurred_At__c)])d.add(new Map<String,Object>{'day'=>String.valueOf(a.get('day')),'count'=>Integer.valueOf(String.valueOf(a.get('total')))});write(r,200,new Map<String,Object>{'data'=>d,'windowDays'=>30});}
    private static void stats(RestResponse r){String dim=RestContext.request.params.get('dimension');List<Map<String,Object>> d=new List<Map<String,Object>>();if(dim=='flow')for(AggregateResult a:[SELECT Flow_Name__c value,COUNT(Id) total FROM Flow_Error__c WITH USER_MODE GROUP BY Flow_Name__c ORDER BY COUNT(Id) DESC LIMIT 200])d.add(new Map<String,Object>{'value'=>a.get('value'),'count'=>a.get('total')});else if(dim=='element')for(AggregateResult a:[SELECT Element_Name__c value,COUNT(Id) total FROM Flow_Error__c WITH USER_MODE GROUP BY Element_Name__c ORDER BY COUNT(Id) DESC LIMIT 200])d.add(new Map<String,Object>{'value'=>a.get('value'),'count'=>a.get('total')});else{write(r,400,error('INVALID_DIMENSION','Only flow and element are supported'));return;}write(r,200,new Map<String,Object>{'data'=>d,'dimension'=>dim});}
    private static void search(RestResponse r){String q=RestContext.request.params.get('q');if(String.isBlank(q)||q.length()<3||q.length()>100){write(r,400,error('INVALID_QUERY','Search must be 3 to 100 characters'));return;}String term='%'+String.escapeSingleQuotes(q.trim())+'%';List<Failure_Group__c> rows=[SELECT Id,Fingerprint__c,Flow_Name__c,Element_Name__c,Error_Type__c,Occurrence_Count__c,Last_Seen__c,Status__c,Representative_Message__c FROM Failure_Group__c WHERE(Flow_Name__c LIKE :term OR Element_Name__c LIKE :term OR Error_Type__c LIKE :term) WITH USER_MODE ORDER BY Last_Seen__c DESC LIMIT 200];write(r,200,new Map<String,Object>{'data'=>rows,'page'=>new Map<String,Object>{'hasMore'=>rows.size()==200,'limit'=>200}});}
    private static void history(RestResponse r,String id){if(!isId(id)){write(r,400,error('INVALID_ID','Group id is invalid'));return;}List<Failure_Activity__c> rows=[SELECT Id,CreatedDate,CreatedBy.Name,Activity_Type__c,From_Status__c,To_Status__c,Notes__c FROM Failure_Activity__c WHERE Failure_Group__c=:id WITH USER_MODE ORDER BY CreatedDate DESC LIMIT 200];write(r,200,new Map<String,Object>{'data'=>rows,'page'=>new Map<String,Object>{'hasMore'=>rows.size()==200,'limit'=>200}});}
    private static Integer limitValue(){Integer n=50;try{String raw=RestContext.request.params.get('limit');if(!String.isBlank(raw))n=Integer.valueOf(raw);}catch(Exception ignored){}return Math.min(Math.max(n,1),200);}
    private static Boolean isId(String value){return value!=null&&Pattern.matches('^[a-zA-Z0-9]{15,18}$',value);}
    private static Map<String,Object> error(String code,String message){return new Map<String,Object>{'error'=>new Map<String,String>{'code'=>code,'message'=>message}};}
    private static void write(RestResponse r,Integer status,Object payload){r.statusCode=status;r.responseBody=Blob.valueOf(JSON.serialize(payload));}
}
