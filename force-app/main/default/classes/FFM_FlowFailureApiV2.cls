@RestResource(urlMapping='/ffm/v2/*')
global with sharing class FFM_FlowFailureApiV2 {
    global class GroupDto { public String id; public String flowName; public String elementName; public String status; public Decimal occurrences; public Datetime lastSeen; public String message; GroupDto(Failure_Group__c g){id=g.Id;flowName=g.Flow_Name__c;elementName=g.Element_Name__c;status=g.Status__c;occurrences=g.Occurrence_Count__c;lastSeen=g.Last_Seen__c;message=g.Representative_Message__c;} }
    global class SampleDto { public String id; public String flowName; public String elementName; public String message; public String recordType; public String status; public Datetime occurredAt; public Boolean redacted; SampleDto(Flow_Error__c s){id=s.Id;flowName=s.Flow_Name__c;elementName=s.Element_Name__c;message=s.Fault_Message__c;recordType=s.Object_Type__c;status=s.Status__c;occurredAt=s.Occurred_At__c;redacted=s.Redaction_Applied__c;} }
    @HttpGet global static void get(){RestResponse r=RestContext.response;headers(r);try{if(!allowed()){write(r,403,error('FORBIDDEN','API access is not enabled'));return;}String route=routeName();if(route=='capabilities'){write(r,200,new Map<String,Object>{'apiVersion'=>'v2','modules'=>new List<String>{'read','grouping','history','preview'}});return;}if(route=='summary'){write(r,200,new Map<String,Object>{'windowDays'=>30,'data'=>summary()});return;}if(route=='groups'){groups(r);return;}if(route=='search'){search(r);return;}if(route=='trends'){trends(r);return;}if(route.startsWith('groups/')&&route.endsWith('/samples')){samples(r,route.substring(7,route.length()-8));return;}if(route.startsWith('groups/')&&route.endsWith('/history')){history(r,route.substring(7,route.length()-8));return;}write(r,404,error('NOT_FOUND','Unknown route'));}catch(AuraHandledException ex){write(r,400,error('INVALID_REQUEST',ex.getMessage()));}catch(Exception ex){write(r,500,error('INTERNAL_ERROR','The request could not be completed'));}}
    @HttpPost global static void post(){RestResponse r=RestContext.response;headers(r);try{if(!allowed()||!FeatureManagement.checkPermission('FFM_Recovery_Preview')){write(r,403,error('FORBIDDEN','Recovery preview access is not enabled'));return;}if(routeName()!='recovery/preview'){write(r,404,error('NOT_FOUND','Unknown route'));return;}Map<String,Object> body=(Map<String,Object>)JSON.deserializeUntyped(RestContext.request.requestBody==null?'{}':RestContext.request.requestBody.toString());Id groupId=(Id)body.get('failureGroupId');Id actionId=(Id)body.get('recoveryActionId');if(groupId==null||actionId==null)throw new AuraHandledException('failureGroupId and recoveryActionId are required');Integer requested=body.containsKey('requestedLimit')?Integer.valueOf(String.valueOf(body.get('requestedLimit'))):50;FFM_RecoveryPreviewService.PreviewResponse p=FFM_RecoveryPreviewService.preview(groupId,actionId,null,requested);write(r,200,new Map<String,Object>{'data'=>new Map<String,Object>{'jobId'=>p.job.Id,'status'=>p.job.Status__c,'dryRun'=>p.job.Dry_Run__c,'requested'=>p.job.Requested_Count__c,'eligible'=>p.job.Eligible_Count__c,'skipped'=>p.job.Skipped_Count__c}});}catch(AuraHandledException ex){write(r,400,error('INVALID_REQUEST',ex.getMessage()));}catch(Exception ex){write(r,400,error('INVALID_REQUEST','The preview request is invalid'));}}
    private static void groups(RestResponse r){Integer n=pageLimit();List<Failure_Group__c> rows=[SELECT Id,Flow_Name__c,Element_Name__c,Occurrence_Count__c,Last_Seen__c,Status__c,Representative_Message__c FROM Failure_Group__c WITH USER_MODE ORDER BY Last_Seen__c DESC,Id DESC LIMIT :n];List<GroupDto> data=new List<GroupDto>();for(Failure_Group__c row:rows)data.add(new GroupDto(row));write(r,200,new Map<String,Object>{'data'=>data,'page'=>new Map<String,Object>{'limit'=>n,'hasMore'=>rows.size()==n}});}
    private static void samples(RestResponse r,String id){if(!validId(id))throw new AuraHandledException('Group id is invalid');Integer n=pageLimit();List<Flow_Error__c> rows=[SELECT Id,Flow_Name__c,Element_Name__c,Fault_Message__c,Object_Type__c,Status__c,Occurred_At__c,Redaction_Applied__c FROM Flow_Error__c WHERE Failure_Group__c=:id WITH USER_MODE ORDER BY Occurred_At__c DESC,Id DESC LIMIT :n];List<SampleDto> data=new List<SampleDto>();for(Flow_Error__c row:rows)data.add(new SampleDto(row));write(r,200,new Map<String,Object>{'data'=>data,'page'=>new Map<String,Object>{'limit'=>n,'hasMore'=>rows.size()==n}});}
    private static void search(RestResponse r){String q=RestContext.request.params.get('q');if(String.isBlank(q)||q.trim().length()<3||q.trim().length()>100)throw new AuraHandledException('Search must be 3 to 100 characters');String term='%'+String.escapeSingleQuotes(q.trim())+'%';List<Failure_Group__c> rows=[SELECT Id,Flow_Name__c,Element_Name__c,Occurrence_Count__c,Last_Seen__c,Status__c,Representative_Message__c FROM Failure_Group__c WHERE(Flow_Name__c LIKE :term OR Element_Name__c LIKE :term) WITH USER_MODE ORDER BY Last_Seen__c DESC LIMIT 200];List<GroupDto> data=new List<GroupDto>();for(Failure_Group__c row:rows)data.add(new GroupDto(row));write(r,200,new Map<String,Object>{'data'=>data,'page'=>new Map<String,Object>{'limit'=>200,'hasMore'=>rows.size()==200}});}
    private static void history(RestResponse r,String id){if(!validId(id))throw new AuraHandledException('Group id is invalid');List<Failure_Activity__c> rows=[SELECT Id,CreatedDate,Activity_Type__c,From_Status__c,To_Status__c,Notes__c FROM Failure_Activity__c WHERE Failure_Group__c=:id WITH USER_MODE ORDER BY CreatedDate DESC LIMIT 200];List<Map<String,Object>> data=new List<Map<String,Object>>();for(Failure_Activity__c a:rows)data.add(new Map<String,Object>{'id'=>a.Id,'createdDate'=>a.CreatedDate,'activityType'=>a.Activity_Type__c,'fromStatus'=>a.From_Status__c,'toStatus'=>a.To_Status__c,'notes'=>a.Notes__c});write(r,200,new Map<String,Object>{'data'=>data,'page'=>new Map<String,Object>{'limit'=>200,'hasMore'=>rows.size()==200}});}
    private static void trends(RestResponse r){Integer days=30;String raw=RestContext.request.params.get('days');if(!String.isBlank(raw))try{days=Integer.valueOf(raw);}catch(Exception ex){throw new AuraHandledException('days must be an integer');}if(days<1||days>90)throw new AuraHandledException('days must be between 1 and 90');DateTime since=System.now().addDays(-days);List<Map<String,Object>> data=new List<Map<String,Object>>();for(AggregateResult a:[SELECT DAY_ONLY(Occurred_At__c) day,COUNT(Id) total FROM Flow_Error__c WHERE Occurred_At__c>=:since WITH USER_MODE GROUP BY DAY_ONLY(Occurred_At__c) ORDER BY DAY_ONLY(Occurred_At__c)])data.add(new Map<String,Object>{'day'=>String.valueOf(a.get('day')),'count'=>a.get('total')});write(r,200,new Map<String,Object>{'windowDays'=>days,'data'=>data});}
    private static Map<String,Integer> summary(){Map<String,Integer> data=new Map<String,Integer>();for(AggregateResult a:[SELECT Status__c status,COUNT(Id) total FROM Failure_Group__c WITH USER_MODE GROUP BY Status__c])data.put(String.valueOf(a.get('status')),Integer.valueOf(String.valueOf(a.get('total'))));return data;}
    private static Integer pageLimit(){String raw=RestContext.request.params.get('limit');if(String.isBlank(raw))return 50;try{Integer n=Integer.valueOf(raw);if(n<1||n>200)throw new AuraHandledException('limit must be an integer from 1 to 200');return n;}catch(AuraHandledException ex){throw ex;}catch(Exception ex){throw new AuraHandledException('limit must be an integer from 1 to 200');}}
    private static Boolean allowed(){return FeatureManagement.checkPermission('FFM_API_Access');}
    private static String routeName(){String p=RestContext.request.requestURI;Integer i=p.indexOf('/ffm/v2/');String out=i>=0?p.substring(i+8):'';return out.endsWith('/')?out.substring(0,out.length()-1):out;}
    private static Boolean validId(String value){return value!=null&&Pattern.matches('^[a-zA-Z0-9]{15,18}$',value);}
    private static Map<String,Object> error(String code,String message){return new Map<String,Object>{'error'=>new Map<String,String>{'code'=>code,'message'=>message}};}
    private static void headers(RestResponse r){r.addHeader('Cache-Control','no-store');r.addHeader('Content-Type','application/json');r.addHeader('X-FFM-RateLimit-Limit','200');r.addHeader('X-FFM-API-Version','v2');}
    private static void write(RestResponse r,Integer status,Object payload){r.statusCode=status;r.responseBody=Blob.valueOf(JSON.serialize(payload));}
}
